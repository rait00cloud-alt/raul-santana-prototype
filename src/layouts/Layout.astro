---
import '../styles/global.css';
import HeaderWithI18n from '../components/UI/HeaderWithI18n.tsx'
import FooterComponent from '../components/UI/Footer.tsx'
---

<!doctype html>
<html class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes='16x16' href="/logo/star.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{Astro.props.title}</title>
  </head>
  <body class="bg-[#131313]">
  <HeaderWithI18n client:load />
    <slot />
  </body>
  <FooterComponent/>
</html>

<style>
  html,
  body {
    margin: 0;
    padding:0;
    min-width: 100%;
    min-height: 100%;
  }
</style>